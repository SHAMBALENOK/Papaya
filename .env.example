# Скопируйте этот файл в `.env` и заполните реальными значениями.
# `.env` исключён из git и никогда не должен попадать в репозиторий.
#
# Использование: docker compose up -d --build
# (docker compose читает `.env` из корня проекта автоматически)

# development | production | test
ENVIRONMENT=development

# Секрет подписи JWT. В production — длинная случайная строка (например,
# из `python -c "import secrets; print(secrets.token_hex(32))"`).
JWT_KEY=change_this_secret_key

# Основная база данных (схема управляется Alembic).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/postgres

# Redis (используется для версионного кэша и очереди Celery).
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_URL=redis://redis:6379/0

# TTL записей кэша, секунд.
CACHE_TTL=600

# Максимальный размер загружаемого документа (PDF/XLSX/изображение), МБ.
MAX_UPLOAD_MB=30

# Ставить Secure-флаг на cookie (true только на HTTPS).
COOKIE_SECURE=false

# Каталог файлов внутри контейнера: сюда складываются загруженные
# документы-источники (DOCS_DIR) и временные файлы импорта (TABLES_DIR).
TABLES_DIR=/app/app/tables
DOCS_DIR=/app/app/tables/docs

# Как запускать импорт документов РСОШ:
#   celery — фоновой задачей (нужен работающий воркер);
#   inline — в процессе API (удобно для локальной проверки);
#   auto  — celery, если брокер доступен, иначе inline (по умолчанию).
RSOSH_EXECUTION=auto

# Разрешение рендеринга PDF-страниц для OCR, dpi. 300 — рабочее значение,
# 600 — запас для мелкого шрифта скана (медленнее).
RSOSH_PDF_DPI=300
